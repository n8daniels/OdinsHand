<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Odin's Hand: a mod-agnostic in-game test harness for Valheim (BepInEx) mods.
    Development only. Reference it from a separate harness plugin, never from the mod you ship.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>OdinsHand</AssemblyName>
    <RootNamespace>OdinsHand</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <Import Project="..\..\build\GameReferences.props" />
</Project>
